{
  "name": "antigravity-vscode-extender",
  "displayName": "Antigravity Extender",
  "description": "Lightweight Antigravity CLI chat sidebar with recoverable conversations and workspace-aware execution",
  "version": "2.5.2",
  "publisher": "antigravity",
  "repository": {
    "type": "git",
    "url": "https://github.com/sacher22/antigravity-vscode-extender.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "out/adapters/**/*.js",
    "out/commands/**/*.js",
    "out/conversation/**/*.js",
    "out/core/**/*.js",
    "out/services/**/*.js",
    "out/ui/**/*.js",
    "media/chat.js",
    "media/chat.css",
    "resources/**/*.png",
    "resources/**/*.svg",
    "README.md",
    "LICENSE",
    "docs/**/*.md"
  ],
  "icon": "resources/antigravity-icon.png",
  "activationEvents": [
    "onView:antigravity.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-sidebar",
          "title": "Antigravity Extender",
          "icon": "resources/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-sidebar": [
        {
          "type": "webview",
          "id": "antigravity.chatView",
          "name": "Antigravity Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.openChat",
        "title": "Antigravity: Open Chat Sidebar",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.newSession",
        "title": "Antigravity: New Conversation",
        "category": "Antigravity"
      }
    ],
    "configuration": {
      "title": "Antigravity Extender",
      "properties": {
        "antigravity.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Antigravity (agy) binary. If empty, automatically detected in PATH and standard locations."
        },
        "antigravity.defaultModel": {
          "type": "string",
          "default": "gemini-3.8-flash-high",
          "enum": [
            "gemini-3.8-flash-high",
            "gemini-3.8-flash-medium",
            "gemini-3.8-flash-low",
            "gemini-3.7-flash-high",
            "gemini-3.7-flash-medium",
            "gemini-3.7-flash-low",
            "gemini-3.6-flash-high",
            "gemini-3.6-flash-medium",
            "gemini-3.6-flash-low",
            "gemini-3.1-pro-high",
            "gemini-3.1-pro-low"
          ],
          "description": "Default model used for Antigravity sessions."
        },
        "antigravity.reasoningEffort": {
          "type": "string",
          "default": "high",
          "enum": [
            "high",
            "medium",
            "low",
            "max"
          ],
          "description": "Reasoning effort / thinking budget level."
        },
        "antigravity.dangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Automatically allow tool execution (file editing, terminal commands) without manual approval prompts (Danger Mode)."
        },
        "antigravity.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scroll to the bottom during agent streaming responses."
        },
        "antigravity.includeProjectRules": {
          "type": "boolean",
          "default": true,
          "description": "Deprecated: project instructions are loaded by the native CLI. This setting does not disable CLI rules.",
          "deprecationMessage": "CLI v1.2.14 has no verified flag to disable project instructions; this setting cannot control native rule loading."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run check:package",
    "compile": "node scripts/clean-build.js && tsc -p ./ && node scripts/build-webview.js",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "node scripts/watch-build.cjs",
    "package": "vsce package --no-dependencies",
    "test:performance": "npm run compile && node scripts/benchmark-webview.cjs",
    "format": "prettier --write src scripts test media/chat.css",
    "archive:symbols": "node scripts/archive-debug-symbols.cjs",
    "check:package": "node scripts/check-package-content.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.3.3"
  }
}
